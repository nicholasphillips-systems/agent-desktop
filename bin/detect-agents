def locate_binary(target):
    if isinstance(target, Path):
        if target.exists() and os.access(target, os.X_OK):
            return str(target)
        return None
    # Check standard PATH
    found = shutil.which(target)
    if found:
        return found
    # Check search paths
    for p in SEARCH_PATHS:
        candidate = p / target
        if candidate.exists() and os.access(candidate, os.X_OK):
            return str(candidate)
    return None

def detect_all():
    results = {}
    for agent_id, info in KNOWN_AGENTS.items():
        bin_path = None
        for b in info["binaries"]:
            bin_path = locate_binary(b)
            if bin_path:
                break
        
        has_config = any(p.exists() for p in info.get("config_dirs", []))
        
        installed = bin_path is not None or has_config
        results[agent_id] = {
            "name": info["name"],
            "vendor": info["vendor"],
            "type": info["type"],
            "installed": installed,
            "binary_path": bin_path,
            "has_config": has_config,
            "icon": info["icon"]
        }
    return results

def main():
    detected = detect_all()
    if "--json" in sys.argv:
        print(json.dumps(detected, indent=2))
        return

    print("=" * 72)
    print("  AI AGENT & INSTANCE SCANNER (Local Detection)")
    print("=" * 72)
    print(f"{'Agent / Tool':<24} {'Type':<6} {'Status':<12} {'Binary Location'}")
    print("-" * 72)
    
    installed_count = 0
    for agent_id, data in detected.items():
        status = "INSTALLED" if data["installed"] else "NOT FOUND"
        color = "\033[32m" if data["installed"] else "\033[2m"
        reset = "\033[0m"
        path = data["binary_path"] or "(config only)" if data["installed"] else "-"
        print(f"{data['name']:<24} {data['type'].upper():<6} {color}{status:<12}{reset} {path}")
        if data["installed"]:
            installed_count += 1
            
    print("-" * 72)
    print(f"Total AI systems detected: {installed_count} of {len(detected)}")
    print("=" * 72)

if __name__ == "__main__":
    main()
