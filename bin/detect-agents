#!/usr/bin/env python3
"""
detect-agents — Scans the system for installed AI coding agents, models, and CLI runners.
Returns structured JSON or human-readable report.
"""

import sys
import os
import shutil
import json
from pathlib import Path

HOME = Path.home()

SEARCH_PATHS = [
    HOME / ".local" / "bin",
    HOME / ".cargo" / "bin",
    HOME / ".kilo" / "bin",
    HOME / ".opencode" / "bin",
    HOME / ".hermes" / "bin",
    Path("/usr/local/bin"),
    Path("/usr/bin"),
    Path("/var/lib/snapd/snap/bin"),
    Path("/opt"),
    HOME / "Applications",
    HOME / "opt",
]

# Add NVM node paths if present
nvm_dir = HOME / ".nvm" / "versions" / "node"
if nvm_dir.exists():
    for node_ver in nvm_dir.iterdir():
        bin_dir = node_ver / "bin"
        if bin_dir.exists():
            SEARCH_PATHS.append(bin_dir)

